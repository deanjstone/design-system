{
  "branches": [
    "deploy"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    "@semantic-release/github",
    [
      "./scripts/release/semantic-release-pin.mjs",
      {
        "buildCommand": "npx --yes shadcn@4.19.1 build --output ./r",
        "releaseFiles": [
          "CHANGELOG.md",
          "package.json"
        ],
        "targetBranch": "main"
      }
    ]
  ]
}
