{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "design-system",
  "homepage": "https://github.com/deanjstone/design-system",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "cssVars": {
        "theme": {
          "radius-sm": "calc(var(--radius) - 4px)",
          "radius-md": "calc(var(--radius) - 2px)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) + 4px)",
          "color-surface-0": "var(--surface-0)",
          "color-surface-1": "var(--surface-1)",
          "color-surface-2": "var(--surface-2)",
          "color-surface-3": "var(--surface-3)",
          "color-surface-4": "var(--surface-4)",
          "color-surface-5": "var(--surface-5)",
          "color-surface-border": "var(--surface-border)",
          "color-surface-border-light": "var(--surface-border-light)",
          "animate-pulse-slow": "pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite",
          "animate-fade-in": "fadeIn 0.3s ease-out",
          "animate-slide-up": "slideUp 0.3s ease-out"
        },
        "light": {
          "radius": "0.625rem",
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.511 0.23 276.966)",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.97 0 0)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.97 0 0)",
          "muted-foreground": "oklch(0.556 0 0)",
          "accent": "oklch(0.97 0 0)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.922 0 0)",
          "input": "oklch(0.922 0 0)",
          "ring": "oklch(0.511 0.23 276.966)",
          "chart-1": "oklch(0.646 0.222 41.116)",
          "chart-2": "oklch(0.6 0.118 184.704)",
          "chart-3": "oklch(0.398 0.07 227.392)",
          "chart-4": "oklch(0.828 0.189 84.429)",
          "chart-5": "oklch(0.769 0.188 70.08)",
          "surface-0": "#06060a",
          "surface-1": "#0c0c14",
          "surface-2": "#13131e",
          "surface-3": "#1a1a28",
          "surface-4": "#222233",
          "surface-5": "#2a2a3d",
          "surface-border": "#2a2a3d",
          "surface-border-light": "#363650"
        },
        "dark": {
          "background": "oklch(0.145 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.205 0 0)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.205 0 0)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.68 0.158 276.935)",
          "primary-foreground": "oklch(0.205 0 0)",
          "secondary": "oklch(0.269 0 0)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.269 0 0)",
          "muted-foreground": "oklch(0.708 0 0)",
          "accent": "oklch(0.269 0 0)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.68 0.158 276.935)",
          "chart-1": "oklch(0.488 0.243 264.376)",
          "chart-2": "oklch(0.696 0.17 162.48)",
          "chart-3": "oklch(0.769 0.188 70.08)",
          "chart-4": "oklch(0.627 0.265 303.9)",
          "chart-5": "oklch(0.645 0.246 16.439)",
          "surface-0": "#06060a",
          "surface-1": "#0c0c14",
          "surface-2": "#13131e",
          "surface-3": "#1a1a28",
          "surface-4": "#222233",
          "surface-5": "#2a2a3d",
          "surface-border": "#2a2a3d",
          "surface-border-light": "#363650"
        }
      },
      "css": {
        "@keyframes fadeIn": {
          "from": {
            "opacity": "0"
          },
          "to": {
            "opacity": "1"
          }
        },
        "@keyframes slideUp": {
          "from": {
            "opacity": "0",
            "transform": "translateY(10px)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateY(0)"
          }
        },
        "@layer components": {
          ".card": {
            "background-color": "var(--color-card)",
            "color": "var(--color-card-foreground)",
            "border": "1px solid var(--color-surface-border)",
            "border-radius": "var(--radius-lg)"
          },
          ".card-hover": {
            "transition": "background-color 0.2s ease, border-color 0.2s ease"
          },
          ".card-hover:hover": {
            "background-color": "var(--color-surface-2)",
            "border-color": "var(--color-surface-border-light)"
          },
          ".btn-primary": {
            "background-color": "var(--color-primary)",
            "color": "var(--color-primary-foreground)",
            "border-radius": "var(--radius-md)"
          },
          ".btn-ghost": {
            "background-color": "transparent",
            "color": "var(--color-foreground)"
          },
          ".btn-ghost:hover": {
            "background-color": "var(--color-accent)",
            "color": "var(--color-accent-foreground)"
          },
          ".badge": {
            "display": "inline-flex",
            "align-items": "center",
            "border-radius": "9999px",
            "padding": "0.125rem 0.625rem",
            "font-size": "0.75rem",
            "font-weight": "500",
            "background-color": "var(--color-secondary)",
            "color": "var(--color-secondary-foreground)"
          },
          ".input": {
            "border": "1px solid var(--color-input)",
            "border-radius": "var(--radius-md)",
            "background-color": "transparent"
          },
          ".input:focus": {
            "outline": "none",
            "box-shadow": "0 0 0 2px var(--color-ring)"
          }
        },
        ".dark ::-webkit-scrollbar": {
          "width": "8px",
          "height": "8px"
        },
        ".dark ::-webkit-scrollbar-track": {
          "background": "transparent"
        },
        ".dark ::-webkit-scrollbar-thumb": {
          "background-color": "var(--color-surface-4)",
          "border-radius": "9999px"
        },
        ".dark ::-webkit-scrollbar-thumb:hover": {
          "background-color": "var(--color-surface-5)"
        },
        ".dark ::selection": {
          "background-color": "var(--color-primary)",
          "color": "var(--color-primary-foreground)"
        },
        ".dark input[type=\"date\"]::-webkit-calendar-picker-indicator, .dark input[type=\"time\"]::-webkit-calendar-picker-indicator": {
          "filter": "invert(1)"
        }
      }
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "files": [
        {
          "path": "registry/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "registryDependencies": [
        "utils"
      ],
      "dependencies": [
        "class-variance-authority",
        "@radix-ui/react-slot"
      ],
      "files": [
        {
          "path": "registry/new-york/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "registry/new-york/ui/card.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "label",
      "type": "registry:ui",
      "registryDependencies": [
        "utils"
      ],
      "dependencies": [
        "@radix-ui/react-label"
      ],
      "files": [
        {
          "path": "registry/new-york/ui/label.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "registry/new-york/ui/input.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "dialog",
      "type": "registry:ui",
      "registryDependencies": [
        "utils"
      ],
      "dependencies": [
        "@radix-ui/react-dialog",
        "lucide-react"
      ],
      "files": [
        {
          "path": "registry/new-york/ui/dialog.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "tabs",
      "type": "registry:ui",
      "registryDependencies": [
        "utils"
      ],
      "dependencies": [
        "@radix-ui/react-tabs"
      ],
      "files": [
        {
          "path": "registry/new-york/ui/tabs.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "registryDependencies": [
        "utils"
      ],
      "dependencies": [
        "class-variance-authority",
        "@radix-ui/react-slot"
      ],
      "files": [
        {
          "path": "registry/new-york/ui/badge.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
