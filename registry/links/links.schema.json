{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/deanjstone/design-system/main/registry/links/links.schema.json",
  "title": "myargus links registry",
  "description": "Structure of links.json. The cross-field rules (host per bucket, redirect targets, unique locations) live in scripts/links/registry.mjs and are enforced by the design-system tests.",
  "type": "object",
  "required": ["revision", "domain", "cookieDomain", "tailnetHost", "entries"],
  "properties": {
    "$comment": { "type": "string" },
    "$schema": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "domain": { "type": "string" },
    "cookieDomain": { "type": "string", "pattern": "^\\." },
    "tailnetHost": { "type": "string", "pattern": "\\.ts\\.net$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "bucket", "status", "hosting", "access", "switcher", "routes", "probe"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "bucket": { "enum": ["internal", "external", "api", "mcp", "tailnet"] },
          "status": { "enum": ["live", "planned", "redirect", "retired"] },
          "host": { "type": "string" },
          "path": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "hosting": { "enum": ["pages", "worker", "tunnel", "tailnet"] },
          "access": { "type": "boolean" },
          "switcher": { "type": "boolean" },
          "redirect": { "type": "string" },
          "moveTo": {
            "type": "object",
            "required": ["host", "path"],
            "properties": { "host": { "type": "string" }, "path": { "type": "string" } }
          },
          "routes": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
          "probe": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["status"],
                "properties": { "status": { "type": "integer", "minimum": 100, "maximum": 599 } }
              }
            ]
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
